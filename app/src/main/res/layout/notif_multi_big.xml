<?xml version="1.0" encoding="utf-8"?>
<!-- Notification (expanded): title, then up to ten posters in two rows of five; the tenth says "More" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/n_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/n_body"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/n_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/n_g1"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/n_g2"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/n_g3"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/n_g4"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/n_g5"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/n_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/n_g6"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/n_g7"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/n_g8"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/n_g9"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <FrameLayout
            android:id="@+id/n_g10_box"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/n_g10"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/n_more"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/notif_more_scrim"
                android:gravity="center"
                android:text="More ›"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
